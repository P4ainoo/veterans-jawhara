{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a squad member or coach.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "birthDate": { "type": "string", "format": "date" },
        "phoneNumber": { "type": "string" },
        "avatarUrl": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["PLAYER", "COACH", "ADMIN"] },
        "jerseyNumber": { "type": "integer" },
        "position": { "type": "string", "enum": ["GK", "DEF", "MID", "FWD"] },
        "healthStatus": { "type": "string", "enum": ["HEALTHY", "INJURED", "RECOVERING", "AWAY"] },
        "avgRating": { "type": "number" },
        "matchCount": { "type": "integer" },
        "goals": { "type": "integer" },
        "assists": { "type": "integer" },
        "yellowCards": { "type": "integer" },
        "redCards": { "type": "integer" },
        "isOnboarded": { "type": "boolean" }
      },
      "required": ["uid", "email", "firstName", "lastName", "role"]
    },
    "Event": {
      "title": "Squad Event",
      "description": "A match, training session, or team event.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["TRAINING", "MATCH", "EVENT"] },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "venue": { "type": "string" },
        "opponent": { "type": "string" },
        "formation": { "type": "string" },
        "pitchAssignments": { "type": "object", "description": "slotId -> userId mapping" },
        "benchAssignments": { "type": "array", "items": { "type": "string" } },
        "isCompleted": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "notes": { "type": "string" },
        "coachSummary": { "type": "string" },
        "status": { "type": "string", "enum": ["SCHEDULED", "COMPLETED", "CANCELLED"] },
        "matchStats": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["type", "date", "time", "venue", "status"]
    },
    "RSVP": {
      "title": "Event RSVP",
      "description": "A player's availability for a specific event.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventId": { "type": "string" },
        "status": { "type": "string", "enum": ["JOINED", "DECLINED", "PENDING"] },
        "note": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Team events"
    },
    "/events/{eventId}/rsvps/{userId}": {
      "schema": "RSVP",
      "description": "Event availability"
    }
  }
}
